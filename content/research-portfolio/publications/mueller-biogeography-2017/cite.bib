 keywords = {Animals, Symbiosis, Phylogeny, *Biological Coevolution, Agaricales/*genetics, Ants/classification/*microbiology, Attamyces bromatificus, Central America, Genetic Markers, Genetics, Population, Genotype, insect-fungus mutualism, Leucoagaricus gongylophorus, Leucoagaricus weberi, Leucocoprinus gongylophorus, Microsatellite Repeats, North America, Phylogeography, South America, symbiosis},
