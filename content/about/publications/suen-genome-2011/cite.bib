 keywords = {Animals, Sequence Analysis, DNA, *Symbiosis, Ants/genetics/*physiology, Arginine/genetics/metabolism, Base Sequence, Fungi/genetics, Genome, Insect/*genetics, Insect Proteins/genetics/metabolism, Plant Leaves/*physiology, Serine Proteases/genetics/metabolism},
