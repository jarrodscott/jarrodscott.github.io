@article{phillips_exploring_2016,
 abstract = {An expedition to the Kavachi submarine volcano (Solomon Islands) in January 2015 was serendipitously timed with a rare lull in volcanic activity that permitted access to the inside of Kavachi's active crater and its flanks. The isolated location of Kavachi and its explosive behavior normally restrict scientific access to the volcano's summit, limiting previous observational efforts to surface imagery and peripheral water-column data. This article presents medium-resolution bathymetry of the main peak along with benthic imagery, biological observations of multiple trophic levels living inside the active crater, petrological and geochemical analysis of samples from the crater rim, measurements of water temperature and gas flux over the summit, and descriptions of the hydrothermal plume structure. A second peak was identified to the southwest of the main summit and displayed evidence of diffuse-flow venting. Microbial samples collected from the summit indicate chemosynthetic populations dominated by sulfur-reducing ε-proteobacteria. Populations of gelatinous animals, small fish, and sharks were observed inside the active crater, raising new questions about the ecology of active submarine volcanoes and the extreme environments in which large marine animals can exist.},
 author = {Phillips, Brennan T. and Dunbabin, Matthew and Henning, Brad and Howell, Corey and DeCiccio, Alex and Flinders, Ashton and Kelley, Katherine A. and Scott, Jarrod J. and Albert, Simon and Carey, Steven and Tsadok, Rami and Grinham, Alistair},
 issn = {10428275, 2377617X},
 issue = {4},
 journal = {Oceanography},
 pages = {160--169},
 publisher = {Oceanography Society},
 title = {Exploring the "Sharkcano": Biogeochemical Observations of the Kavachi Submarine Volcano (Solomon Islands)},
 url = {http://www.jstor.org/stable/24862291},
 urldate = {2026-06-01},
 volume = {29},
 year = {2016}
}
